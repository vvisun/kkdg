// example FlatBuffers schema
namespace MyGame;

enum Color : byte {
  Red = 1,
  Green = 2,
  Blue = 8
}

struct Vec3 {
  x: float;
  y: float;
  z: float;
}

table Monster {
  pos: Vec3;
  mana: short = 150;
  hp: short = 100;
  name: string;
  inventory: [ubyte];
  color: Color = Blue;
}

root_type Monster;
